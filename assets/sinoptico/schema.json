{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template de laudo sinóptico",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "secoes"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titulo", "orgao", "procedimento", "fonte", "versao", "revisao"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "titulo": { "type": "string", "minLength": 1 },
        "orgao": { "type": "string", "minLength": 1 },
        "procedimento": { "type": "string", "minLength": 1 },
        "fonte": { "type": "string", "minLength": 1 },
        "versao": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "revisao": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "estadiamento": { "type": "string" }
      }
    },
    "variaveis": { "type": "array", "items": { "$ref": "#/$defs/variavel" } },
    "secoes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/secao" } },
    "linhaFinal": { "type": "string" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
    "variavel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primeiroDe"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primeiroDe": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["campo"],
            "properties": { "campo": { "$ref": "#/$defs/id" }, "fator": { "type": "number" } }
          }
        }
      }
    },
    "secao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "campos"],
      "properties": {
        "titulo": { "type": "string", "minLength": 1 },
        "cabecalhoLaudo": { "type": "string" },
        "espacoAntes": { "type": "boolean" },
        "campos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/campo" } }
      }
    },
    "campo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rotulo", "tipo"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rotulo": { "type": "string", "minLength": 1 },
        "rotuloLaudo": { "type": "string", "minLength": 1 },
        "tipo": { "enum": ["unica", "multipla", "numero", "texto", "calculado"] },
        "nucleo": { "type": "boolean" },
        "ajuda": { "type": "string" },
        "semSugestao": { "type": "string" },
        "unidade": { "type": "string" },
        "multilinha": { "type": "boolean" },
        "semRotulo": { "type": "boolean" },
        "omitirNoLaudo": { "type": "boolean" },
        "permiteOutro": { "type": "boolean" },
        "permiteNaoAvaliavel": { "type": "boolean" },
        "formato": { "type": "string", "pattern": "\\{valor\\}" },
        "formatoUm": { "type": "string", "pattern": "\\{valor\\}" },
        "separador": { "type": "string" },
        "anexaEm": { "$ref": "#/$defs/id" },
        "visivelSe": { "$ref": "#/$defs/condicao" },
        "opcoes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/opcao" } },
        "regras": { "type": "array", "items": { "$ref": "#/$defs/regra" } },
        "prefixo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["padrao"],
          "properties": {
            "padrao": { "type": "string" },
            "regras": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["se", "valor"],
                "properties": { "se": { "$ref": "#/$defs/condicao" }, "valor": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "opcao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "rotulo"],
      "properties": {
        "valor": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "rotulo": { "type": "string", "minLength": 1 },
        "texto": { "type": "string", "minLength": 1 },
        "exclusiva": { "type": "boolean" }
      }
    },
    "regra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["se", "resultado"],
      "properties": {
        "se": { "$ref": "#/$defs/condicao" },
        "resultado": { "type": "string" },
        "exclusivo": { "type": "boolean" }
      }
    },
    "condicao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "todos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condicao" } },
        "algum": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condicao" } },
        "nao": { "$ref": "#/$defs/condicao" },
        "campo": { "$ref": "#/$defs/id" },
        "igual": { "type": "string" },
        "em": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "naoEm": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "contem": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "contagemMin": { "type": "number" },
        "contagemMax": { "type": "number" },
        "contagemDe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valores"],
          "properties": {
            "valores": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "preenchido": { "type": "boolean" },
        "maiorQue": { "type": "number" },
        "maiorOuIgual": { "type": "number" },
        "menorQue": { "type": "number" },
        "menorOuIgual": { "type": "number" }
      }
    }
  }
}
